# ==========================================
# 🔑 SÉCURITÉ & SECRETS (CLÉS, MOTS DE PASSE)
# ==========================================
# Fichiers d'environnement et variables
*.env
*.env.local
*.env.*.local

# Clés privées SSH et certificats
*.pem
*.key
*.crt
*.csr
*.pfx
*.p12
*.id_rsa
id_rsa*
*_rsa

# Dossiers contenant des identifiants ou secrets
secrets/
credentials/
*.pem.key

# Exclusions explicites de mots de passe / tokens
*password*
*token*
*secret*

# ==========================================
# ⚙️ SAUVEGARDES & EXPORTS D'INFRASTRUCTURE
# ==========================================
# Exports de configurations pfSense / OPNsense (contiennent des mdp/hash)
config-*.xml
pfsense-backup*.xml

# Sauvegardes Proxmox (VZDump / PBS) et ISOs
*.vma
*.vma.gz
*.vma.zst
*.iso
*.img
*.qcow2

# ==========================================
# 💻 FICHIERS SYSTÈME TEMPORAIRES
# ==========================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.fuse_hidden*

# ==========================================
# 🛠️ ÉDITEURS DE CODE (VS CODE, ETC.)
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace
